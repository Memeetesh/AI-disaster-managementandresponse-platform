# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Backend / Database ---
# Local docker-compose Postgres+PostGIS:
DATABASE_URL=postgresql+psycopg2://drishti:drishti@localhost:5432/drishti
# Or a Supabase project (preferred — no local Postgres install needed):
# DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<project>.supabase.co:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-value

# --- Redis (WebSocket pub/sub, optional for a single-instance demo) ---
REDIS_URL=redis://localhost:6379/0

# --- Demo warm-up ---
# On boot the backend pre-fetches the 4 weather forecasts for this point so
# the citizen home cards are live on the first page load. Set to your demo
# venue's coordinates before a presentation.
DEMO_LAT=
DEMO_LON=

# --- External integrations (all optional — app falls back to simulator/mock data if unset) ---
IMD_API_KEY=
# Support-chat companion. Without LLM_API_KEY the chat returns a fixed
# supportive reply + helplines. Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=
LLM_PROVIDER=gemini            # gemini | openai | openrouter
LLM_MODEL=gemini-3.6-flash
OSRM_URL=http://localhost:5000

# --- Risk engine weights (must sum to 1.0) — see backend/app/risk/engine.py ---
RISK_WEIGHT_HAZARD=0.35
RISK_WEIGHT_POPULATION=0.25
RISK_WEIGHT_INFRASTRUCTURE=0.20
RISK_WEIGHT_ACCESSIBILITY=0.10
RISK_WEIGHT_HISTORICAL=0.10

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/ws
# Not tile.openstreetmap.org — it blocks embedded apps like this one under
# its Tile Usage Policy. CARTO's basemap tiles are still OSM-sourced data,
# served from an endpoint meant for this kind of use, free, no key needed.
NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
# Fallback coordinates for the home page when the browser denies / can't
# resolve geolocation (e.g. a laptop on stage). Cards use these so they
# still show real, location-based forecasts.
NEXT_PUBLIC_DEMO_LAT=
NEXT_PUBLIC_DEMO_LON=
